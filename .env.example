# --- Environment Setup ---
ENV=development

# --- Project Metadata ---
PROJECT_NAME="SpaceEye-GeoAI"

# --- API Keys (uncomment as needed) ---
# HF_TOKEN=
# OPENAI_API_KEY=

# spaceeye-geoai — production environment variables (per architecture layer 4 / 7)
MASK_SALT=change-me-in-production-use-random-hex-string
# The default model and call budget live in configs/ai.yaml; GEMINI_MODEL overrides the model when set.
# Put GEMINI_API_KEY only in the git-ignored .env file.
# Put the Gemini key after the = sign; the dashboard chatbot and the project use this one key.
# Calls are allowed because approval is approved in configs/ai.yaml, and are still capped by the budget.
GEMINI_API_KEY=
GEMINI_MODEL=
